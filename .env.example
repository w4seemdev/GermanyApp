# ─────────────────────────────────────────────────────────────────────────────
# Zukunft Service - environment
#
# Copy to .env.local and fill in. Everything prefixed NEXT_PUBLIC_ is compiled
# into the browser bundle and is therefore PUBLIC. Never put a secret behind
# that prefix.
#
# NOTE: the phone number, email and postal address are NOT configured here.
# They live in src/content/shared/nap.ts, because the footer, the contact page,
# the WhatsApp button and the LocalBusiness JSON-LD must all render the same
# values - a split between env and content is how a business ends up with two
# different phone numbers on one site.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute site origin. Used for canonical URLs, hreflang, sitemap.xml,
# robots.txt and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://zukunftservice.de

# Contact form transport: "mock" or "http".
#   mock - simulates a successful send after 700ms and logs the payload in dev.
#          The UI is fully demonstrable to the client with no backend.
#   http - POSTs to NEXT_PUBLIC_CONTACT_ENDPOINT. See HANDOFF.md for the
#          request and response contract.
NEXT_PUBLIC_CONTACT_TRANSPORT=mock

# Where the contact form POSTs when transport is "http". Required in that mode;
# with it empty the form reports an error rather than silently dropping enquiries.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# ─── Server-side only. Never prefixed NEXT_PUBLIC_. ──────────────────────────
# The inbox the backend delivers enquiries to. Put the visitor's address in
# Reply-To, never in From, or SPF/DKIM will fail and the mail will be filtered
# as spam. See HANDOFF.md.
CONTACT_RECIPIENT_EMAIL=info@zukunftservice.de
