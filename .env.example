# Public site origin, used for canonical URLs, hreflang and JSON-LD
NEXT_PUBLIC_SITE_URL=https://zukunftservice.de

# Contact form transport: "mock" (default, no backend needed) or "http"
NEXT_PUBLIC_CONTACT_TRANSPORT=mock

# Absolute https URL of the backend endpoint. Required when TRANSPORT=http.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Owner's WhatsApp number, digits only, no "+", no spaces
NEXT_PUBLIC_WHATSAPP=491773825632

# Public contact address for mailto / noscript fallbacks
NEXT_PUBLIC_CONTACT_EMAIL=info@zukunftservice.de

# --- Backend developer only (never exposed to the browser) ---
CONTACT_RECIPIENT_EMAIL=info@zukunftservice.de
